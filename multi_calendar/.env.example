# Multi-Calendar demo — provider app credentials (operator setup, one time).
# Copy to multi_calendar/.env and fill in. Never commit .env.
#
# Google: create an OAuth client in Google Cloud Console, type "Web application",
# authorized redirect URI http://localhost:5174/oauth/google, and enable the
# Google Calendar API. End users never see these — they just click
# "Connect Google Calendar" and authorize on Google's consent page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Feishu: create a custom app with the calendar read scope family
# (calendar:calendar:readonly) and publish it to your tenant.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: pin a specific calendar; defaults to the primary visible calendar.
FEISHU_CALENDAR_ID=
